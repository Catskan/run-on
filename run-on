#!/usr/bin/env bash
# run-on : exécute une commande lourde sur un poste client (le « bras » d'exécution),
# avec fallback automatique et conscience des repos montés en SSHFS.
#
#   run-on auto   "<cmd>"   -> repo monté: son poste propriétaire ; sinon hôte actif,
#                              sinon 1er poste joignable (ordre). Repli local: opt-in (voir plus bas).
#   run-on <nom>  "<cmd>"   -> poste explicite du registre
#   run-on local  "<cmd>"   -> force l'exécution locale dans le conteneur/brain
#
# Repli local : par défaut DÉSACTIVÉ (E1). Si aucun poste n'est joignable, run-on échoue (exit 3)
# au lieu d'exécuter silencieusement builds/git dans le conteneur (mauvais environnement, sur une
# vue SSHFS parfois morte). Forcer avec RUNON_FALLBACK_LOCAL=1 (ou `run-on local`).
#
# Registre : config/hosts.json. Montages : ~/.config/run-on/mounts.tsv (via mount-repo).
set -euo pipefail

_lib="/usr/local/lib/nas-remote.sh"
[ -f "$_lib" ] || _lib="$(dirname "$(readlink -f "$0")")/lib/nas-remote.sh"
# shellcheck source=/dev/null
. "$_lib"

ACTIVE_FILE="${RUNON_STATE_DIR:-$HOME/.config/run-on}/active-host"

HOSTS="$(nr_find_hosts || true)"
[ -n "$HOSTS" ] || { echo "run-on: hosts.json introuvable." >&2; exit 2; }

TARGET="${1:-auto}"; shift || true
# Contrat d'arguments (F17, anti-quoting) — préserve argv FIDÈLEMENT :
#   - 1 SEUL argument     -> chaîne shell verbatim (pipes/&&/globs interprétés côté distant).
#   - PLUSIEURS arguments -> argv LITTÉRAL : chaque token requoté avec printf %q, ce qui re-parse
#     en argv IDENTIQUE côté distant (bash comme zsh). Guillemets, espaces et '*' sont préservés
#     tels quels -> fini les messages tronqués (`-m "a b"`), l'expansion de glob surprise et le
#     « no matches found » de zsh. CMD reste une chaîne POSIX valide : détection is_network_git,
#     log et payload unix/local la consomment sans changement.
ARGS=("$@")
[ "${#ARGS[@]}" -gt 0 ] || { echo "run-on: aucune commande fournie." >&2; exit 2; }
if [ "${#ARGS[@]}" -eq 1 ]; then
  CMD="${ARGS[0]}"
else
  CMD="$(printf '%q ' "${ARGS[@]}")"; CMD="${CMD% }"
fi

reachable()       { local s; s="$(host_ssh_addr "$1")"; [ -n "$s" ] || return 1; reachable_ssh "$s"; }
reachable_retry() { local s; s="$(host_ssh_addr "$1")"; [ -n "$s" ] || return 1; reachable_ssh_retry "$s"; }

# Commande git RÉSEAU (a besoin du remote GitHub, pas juste du dépôt local) ?
is_network_git() {
  case "$CMD" in
    *"git push"*|*"git fetch"*|*"git pull"*|*"git clone"*|*"git ls-remote"*|*"git remote update"*) return 0 ;;
    *) return 1 ;;
  esac
}

run_local() {
  if [ "$TARGET" = "local" ] || [ "${RUNON_FALLBACK_LOCAL:-0}" = "1" ]; then
    echo "run-on → local (brain) : $CMD" >&2
    exec bash -lc "$CMD"
  fi
  echo "run-on: aucun poste joignable. Repli local désactivé (builds/git ne doivent pas tourner" >&2
  echo "        ici, mauvais environnement). Réessaie dans ~30 s, ou force avec RUNON_FALLBACK_LOCAL=1 / 'run-on local'." >&2
  exit 3
}

# Exécute CMD sur <name> dans le dossier distant <dir>, via <ssh_override> si fourni.
# Transport de commande ROBUSTE (F11) : la commande n'est JAMAIS ré-interpolée. On l'encode en
# base64 (uniquement [A-Za-z0-9+/=], donc rien à échapper au niveau ssh) et on la décode côté
# distant vers le SHELL DE LOGIN de l'utilisateur ($SHELL -ls, lit le script sur stdin) -> PATH
# complet (homebrew/nvm/volta) ET agnostique au shell (bash/zsh) : apostrophes, guillemets, `$`,
# `;` dans un chemin ou la commande ne cassent plus rien.
exec_remote() {
  local name="$1" dir="$2" ssh_override="${3:-}" ssh os payload b64 wdir wenc pscmd wcmd a
  ssh="${ssh_override:-$(host_ssh_addr "$name")}"
  split_endpoint "$ssh"
  os="$(nr_host_field "$HOSTS" "$name" os)"
  echo "run-on → $name ($os, $EP_ADDR:$EP_PORT) : [$dir] $CMD" >&2

  if [ "$os" = "windows" ]; then
    # $dir au format sftp (/M:/...) -> retirer le / initial ; échapper les apostrophes pour PowerShell.
    wdir="${dir#/}"; wdir="${wdir//\'/\'\'}"
    # Reconstituer la commande pour PowerShell depuis argv : le %q de CMD est du quoting bash,
    # inadapté à PowerShell. 1 arg = verbatim ; sinon chaque token en littéral single-quote ('' échappe).
    if [ "${#ARGS[@]}" -eq 1 ]; then
      wcmd="${ARGS[0]}"
    else
      wcmd=""; for a in "${ARGS[@]}"; do wcmd+="'${a//\'/\'\'}' "; done; wcmd="${wcmd% }"
    fi
    pscmd="Set-Location -LiteralPath '$wdir' -ErrorAction Stop; $wcmd"
    if command -v iconv >/dev/null 2>&1; then
      # -EncodedCommand : PowerShell attend de l'UTF-16LE en base64 -> zéro problème de quoting.
      wenc="$(printf '%s' "$pscmd" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')"
      exec ssh "${SSH_OPTS[@]}" -p "$EP_PORT" "$EP_ADDR" "powershell -NoProfile -EncodedCommand $wenc"
    else
      exec ssh "${SSH_OPTS[@]}" -p "$EP_PORT" "$EP_ADDR" "powershell -NoProfile -Command \"$pscmd\""
    fi
  fi

  # unix : payload = cd (chemin quoté) + éventuel GIT_SSH_COMMAND + la commande, verbatim.
  # GIT_SSH_COMMAND n'est injecté que si le dépôt courant a un remote sur la MACHINE-CERVEAU
  # (le poste headless qui héberge le "brain" Claude Code). Il portait une clé d'automatisation
  # dédiée avec `IdentitiesOnly=yes`, ce qui court-circuite ~/.ssh/config et impose cette seule clé
  # à TOUTE opération git réseau : un `git push` vers GitHub partait avec cette clé et GitHub
  # répondait « Repository not found » — erreur trompeuse, on croit le dépôt absent alors que
  # c'est la clé. Diagnostiqué en creusant côté SSH nu vs `git ls-remote` sur le même alias : le
  # SSH nu passait (agent forwarding, bonne identité), git échouait (clé forcée, mauvaise identité).
  # CAUSE EXACTE : la clé d'automatisation était enregistrée sur un DEUXIÈME compte GitHub
  # personnel (pas celui qui possède les dépôts visés). Proposée en premier par le client SSH, elle
  # est ACCEPTÉE, et GitHub répond alors avec l'identité du mauvais compte — qui n'a pas accès aux
  # dépôts ciblés. Retirer `IdentitiesOnly` n'y change donc rien (la clé est acceptée avant tout
  # repli) : la seule protection est de NE PAS l'injecter hors des dépôts hébergés par la
  # machine-cerveau, ce que fait le test ci-dessous. Limite connue : le test porte sur le dépôt
  # d'ENTRÉE, donc une commande qui commence par un `cd` vers ce dépôt ne recevra pas la clé — cas
  # non rencontré, run-on entrant normalement dans le dépôt visé. Correctif définitif si le besoin
  # revient : un bloc `Host` dédié dans ~/.ssh/config (IdentityFile + Port) et plus aucune injection ici.
  payload="cd $(printf '%q' "$dir") || exit 3
[ -n \"\${ZSH_VERSION:-}\" ] && setopt no_nomatch 2>/dev/null || true
if [ -f \"\$HOME/.ssh/id_brain_automation\" ] && git remote -v 2>/dev/null | grep -qE '@brain[.:]'; then export GIT_SSH_COMMAND='ssh -i ~/.ssh/id_brain_automation -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new'; fi
$CMD"
  b64="$(printf '%s' "$payload" | base64 | tr -d '\n')"
  # -A : forward l'agent SSH. Le décodage alimente un shell de LOGIN via stdin.
  exec ssh -A "${SSH_OPTS[@]}" -p "$EP_PORT" "$EP_ADDR" "printf %s '$b64' | base64 --decode | \"\$SHELL\" -ls"
}

# Dossier distant pour un repo partagé : workspace du poste + chemin relatif à /workspaces.
remote_dir_for() {
  local name="$1" ws
  case "$PWD" in
    /workspaces/*) ;;
    *) echo "run-on: PWD hors /workspaces ($PWD) — précise un dossier de repo monté, ou 'run-on local'." >&2
       exit 2 ;;
  esac
  ws="$(nr_host_field "$HOSTS" "$name" workspace)"
  printf '%s%s' "$ws" "${PWD#/workspaces}"
}

# --- Repo monté en SSHFS sous PWD ? -> exécuter chez le propriétaire, au vrai chemin ---
MOUNT_HOST=""; MOUNT_DIR=""; MOUNT_SSH=""
if [ -f "$MOUNTS" ]; then
  while IFS=$'\t' read -r mnt mhost mremote mssh; do
    [ -n "$mnt" ] || continue
    case "$PWD/" in
      "$mnt"/*)
        MOUNT_HOST="$mhost"
        MOUNT_DIR="${mremote}${PWD#"$mnt"}"
        MOUNT_SSH="$mssh"
        break ;;
    esac
  done < "$MOUNTS"
fi

if [ -n "$MOUNT_HOST" ] && [ "$TARGET" != "local" ]; then
  # Garde-fou : repo hébergé sur un hôte role=storage (ex. un NAS, pas d'accès GitHub)
  # + commande git RÉSEAU -> impossible de l'exécuter là. Message clair (au lieu d'un "injoignable"
  # trompeur) : pousse/fetch depuis un client qui voit ce dépôt.
  if is_network_git && [ "$(nr_host_field "$HOSTS" "$MOUNT_HOST" role)" = "storage" ]; then
    echo "run-on: '$MOUNT_HOST' héberge ce repo mais est du STOCKAGE (pas d'accès GitHub) -> une" >&2
    echo "        opération git réseau ne peut pas s'y exécuter. Pousse/fetch depuis un client qui" >&2
    echo "        voit ce dépôt (ex. le partage monté sur un poste de dev) : cd <repo> && git push." >&2
    exit 4
  fi
  # Tunnel inverse (user@localhost[:port]) : joignable QUE par ce tunnel -> tel quel.
  case "$MOUNT_SSH" in
    *@localhost|*@localhost:*|*@127.0.0.1|*@127.0.0.1:*)
      ssh_addr="$MOUNT_SSH" ;;
    *)
      ssh_addr="$(host_ssh_addr "$MOUNT_HOST")"
      [ -n "$ssh_addr" ] || ssh_addr="$MOUNT_SSH" ;;
  esac
  if reachable_ssh_retry "$ssh_addr"; then exec_remote "$MOUNT_HOST" "$MOUNT_DIR" "$ssh_addr"; fi
  echo "run-on: '$MOUNT_HOST' ($ssh_addr, propriétaire du repo monté) : $(nr_ssh_reason)." >&2
  exit 3
fi

# --- Résolution standard ---
case "$TARGET" in
  local)
    run_local ;;
  auto)
    # ACTIVE_FILE est optionnel et self-stamped : rien ne l'écrit ici. Si TON setup sait quel
    # poste "t'a" en ce moment (ex. le wrapper qui t'y connecte), fais-le écrire le nom de l'hôte
    # dans ce fichier -> `auto` l'essaiera en premier. Absent, `auto` retombe direct sur l'ordre.
    active="$(cat "$ACTIVE_FILE" 2>/dev/null || true)"
    if [ -n "$active" ] && [ "$(nr_host_field "$HOSTS" "$active" ssh)" != "" ] && reachable_retry "$active"; then
      dir="$(remote_dir_for "$active")" || exit $?
      exec_remote "$active" "$dir"
    fi
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if reachable "$name"; then
        dir="$(remote_dir_for "$name")" || exit $?
        exec_remote "$name" "$dir"
      fi
    done < <(jq -r '.order[]?' "$HOSTS")
    echo "run-on: aucun poste joignable." >&2
    run_local ;;
  *)
    if [ "$(nr_host_field "$HOSTS" "$TARGET" ssh)" = "" ]; then
      echo "run-on: hôte inconnu '$TARGET' (voir hosts.json)." >&2; exit 2
    fi
    if reachable_retry "$TARGET"; then
      dir="$(remote_dir_for "$TARGET")" || exit $?
      exec_remote "$TARGET" "$dir"
    else
      echo "run-on: '$TARGET' : $(nr_ssh_reason)." >&2; exit 3
    fi ;;
esac
